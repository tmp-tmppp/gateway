{
  "name": "gateway",
  "description": "Local proof of the Chance API gateway: Traefik, oauth2-proxy and echo backends in Docker, with tests of the routes, roles, limits and headers. The gateway itself is the Helm chart in helm/.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts --maxWorkers=1",
    "stack:down": "node local/down.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
