# Names of the keys in the Secret gateway-env (organization secret GATEWAY_ENV). Placeholders only.
# Client secret: any random string; oauth2-proxy requires one although no login flow is used.
# Cookie secret: exactly 16, 24 or 32 bytes (for example 32 hexadecimal characters).
OAUTH2_PROXY_CLIENT_SECRET=CHANGE_ME
OAUTH2_PROXY_COOKIE_SECRET=CHANGE_ME_TO_32_CHARACTERS_
